{
  "name": "dsh-tool-gate",
  "version": "0.3.1",
  "description": "按家族收起第三方工具并用网关按需披露；内置工具家族、逐插件提示词披露、自建设置页",
  "keywords": [
    "builtin-families",
    "cache",
    "context",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "progressive-disclosure",
    "prompt-disclosure",
    "prompt-withholding",
    "tools"
  ],
  "license": "MIT",
  "author": "kaka100330",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaka100330/dsh-tool-gate.git"
  },
  "homepage": "https://github.com/kaka100330/dsh-tool-gate#readme",
  "bugs": {
    "url": "https://github.com/kaka100330/dsh-tool-gate/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/",
    "README.md",
    "LICENSE",
    "scripts/gen-prompt-attribution.mjs",
    "scripts/gen-attribution.mjs",
    "test/",
    "data/"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
